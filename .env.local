# Copy to .env.local and fill in. NEVER commit or share .env.local.

# Backend API (use your own HTTPS domain, e.g. https://api.yourdomain.com/api/v1 - not a temporary tunnel)
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# NOTE: NEXT_PUBLIC_* values are visible to every visitor in the browser bundle.
NEXT_PUBLIC_DASHBOARD_API_KEY=

# Must be the exact public https URL of this dashboard (no trailing slash)
NEXTAUTH_URL=https://your-dashboard-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

NEXT_PUBLIC_ADMIN_IDS=
NEXT_PUBLIC_BRAND_NAME=Nexus
NEXT_PUBLIC_BRAND_NAME_WORD=NX
